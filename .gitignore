node_modules
.vercel

.vercel

# agent worktrees and local tooling: never committed, never deployed.
# EXCEPT .claude/briefs/, which is DESIGN, not tooling: approved briefs that docs/QUEUE.md §2 and
# docs/briefs/ refer to by path. Ignored, they existed on one machine only. Narrow the rule, never force-add.
.claude/*
!.claude/briefs/
.env*.local

# generated audit output: the .md reports in audits/ are written, the subdirectories are TOOL OUTPUT.
# textfit, lookpass and popclutter used to default into one person's home directory; they now default into
# the repo (audits/readability/), which is right - but their pictures and json must not be committed.
audits/*/
