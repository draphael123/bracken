      "content": "// Only separately verified, fixed-input pure art factories may enter this catalogue.\n// Reflection materializes data properties, preserving the original public descriptors.\nconst factories=new WeakMap();\nconst catalogueStates=new WeakMap();\nexport function deferredPureSprite(build){const token=Object.create(null);factories.set(token,build);return token;}\nexport function deferredPureSpriteCall(fn,receiver,args){return deferredPureSprite(()=>Reflect.apply(fn,receiver,args));}\nexport function deferredSpriteState(catalogue){return catalogueStates.get(catalogue)?.();}\nexport function makeDeferredSpriteCatalogue(target,withOriginalOwnership){\n let proxy,built=0;\n const materialize=key=>{const d=Reflect.getOwnPropertyDescriptor(target,key);if(d&&'value'in d&&factories.has(d.value)){const value=withOriginalOwnership(factories.get(d.value));if(!Reflect.defineProperty(target,key,{...d,value}))throw new TypeError('cannot materialize sprite data');built++;return {...d,value};}return d;};\n const handlers={\n  get(t,key,receiver){materialize(key);return Reflect.get(t,key,receiver);},\n  getOwnPropertyDescriptor(t,key){return materialize(key);},\n  set(t,key,value,receiver){if(receiver===proxy){const d=Reflect.getOwnPropertyDescriptor(t,key);if(d&&'value'in d){if(!d.writable)return false;return Reflect.defineProperty(t,key,{...d,value});}}return Reflect.set(t,key,value,receiver);},\n  defineProperty(t,key,descriptor){const current=Reflect.getOwnPropertyDescriptor(t,key),next={...descriptor};if('value'in next&&factories.has(next.value)&&(next.writable===false||next.configurable===false||(!current&&next.configurable!==true)))next.value=withOriginalOwnership(factories.get(next.value));else if(current&&'value'in current&&factories.has(current.value)&&(next.writable===false||next.configurable===false))materialize(key);return Reflect.defineProperty(t,key,next);}\n };\n proxy=new Proxy(target,handlers);catalogueStates.set(proxy,()=>({built,pending:Reflect.ownKeys(target).filter(key=>{const d=Reflect.getOwnPropertyDescriptor(target,key);return d&&'value'in d&&factories.has(d.value);}).length}));return proxy;\n}\n",
