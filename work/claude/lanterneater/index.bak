<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<!-- viewport-fit=cover and no user scaling: on a phone the game wants the whole glass, and a pinch-zoom in the
     middle of a fight is never what anybody meant -->
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0b1410">
<meta name="apple-mobile-web-app-title" content="BRACKEN">
<link rel="manifest" href="./manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="./icons/icon-192.png">
<link rel="apple-touch-icon" href="./icons/apple-touch-icon-180.png">
<title>BRACKEN</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Silkscreen&family=VT323&display=swap" rel="stylesheet">
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #0b1410; }
  /* dvh follows the phone's shrinking address bar; the old 100% jumped every time it hid */
  @supports (height: 100dvh) { html, body { height: 100dvh; } }
  /* the notch and the home bar, read by src/touch.js so no button sits under them (viewport-fit=cover above) */
  #safe { position: fixed; left: 0; top: 0; width: 0; height: 0; visibility: hidden; pointer-events: none;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px); }
  body { touch-action: none; overscroll-behavior: none; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  canvas#c { position: fixed; inset: 0; width: 100%; height: 100%; display: block; image-rendering: pixelated; image-rendering: crisp-edges; }
  #boot { position: fixed; left: 12px; bottom: 10px; color: #cfc6b0; font: 12px monospace; opacity: .8; pointer-events: none; }
  /* TURN IT SIDEWAYS: the game is a wide window and a portrait phone letterboxes it into a stamp */
  #rotate { position: fixed; inset: 0; display: none; z-index: 30; background: #0b1410; color: #e8dcc0;
    font: 14px/1.6 monospace; text-align: center; align-items: center; justify-content: center; flex-direction: column; gap: 14px; padding: 24px; }
  #rotate b { color: #ffd36b; letter-spacing: 2px; }
  #rotate .ph { width: 54px; height: 90px; border: 3px solid #8fd160; border-radius: 8px; animation: tip 1.8s ease-in-out infinite; }
  @keyframes tip { 0%, 40% { transform: rotate(0deg); } 60%, 100% { transform: rotate(-90deg); } }
  #rotate .bk { color: #ffd36b; font: 22px monospace; letter-spacing: 6px; }
  #rotate button { margin-top: 6px; background: none; border: 2px solid #8fd160; color: #8fd160; font: 12px monospace;
    padding: 8px 14px; border-radius: 6px; letter-spacing: 1px; }
  @media (orientation: portrait) and (pointer: coarse) { #rotate { display: flex; } }
  body.upright #rotate { display: none !important; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="safe"></div>
<div id="rotate"><div class="bk">BRACKEN</div><div class="ph"></div><b>TURN IT SIDEWAYS</b><div>BRACKEN plays in landscape.<br>Rotate the phone and tap to play full screen.</div><button id="anyway">play it upright anyway</button></div>
<div id="boot"></div>
<script>
  // and a way past it: some people are going to play this on a phone held upright whatever we say
  addEventListener('DOMContentLoaded', () => { const b = document.getElementById('anyway');
    if (b) b.addEventListener('click', e => { e.stopPropagation(); document.body.classList.add('upright'); }); });
</script>
<script>
  // DEV TEXT ONLY WITH ?debug: a player is shown the loading scene, never "booting..."
  if (/[?&]debug/.test(location.search)) { const b0 = document.getElementById('boot'); if (b0) b0.textContent = 'booting…'; }
  window.addEventListener('error', e => { const b = document.getElementById('boot'); if (b) { b.textContent = 'ERROR: ' + e.message + ' @' + (e.filename||'').split('/').pop() + ':' + e.lineno; b.style.color = '#ff7a6b'; } });
  setTimeout(() => { const b = document.getElementById('boot'); if (b && !window.BK) { b.textContent = /[?&]debug\b/.test(location.search) ? 'still booting after 8s - check console' : 'STILL LOADING - SLOW CONNECTION?'; } }, 8000);

  // FULL SCREEN ON A PHONE. A browser only grants it inside a real gesture, so the first touch asks for it (and
  // for landscape, where the platform allows). Desktop is left alone: there a key or the menu asks instead.
  (function () {
    const coarse = matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
    const go = () => {
      const el = document.documentElement;
      try { if (!document.fullscreenElement && el.requestFullscreen) el.requestFullscreen({ navigationUI: 'hide' }).catch(() => {}); } catch (e) {}
      try { if (screen.orientation && screen.orientation.lock) screen.orientation.lock('landscape').catch(() => {}); } catch (e) {}
    };
    window.bkFullscreen = () => { if (document.fullscreenElement) { try { document.exitFullscreen(); } catch (e) {} } else go(); };
    if (coarse) {
      const once = () => { go(); removeEventListener('touchend', once); removeEventListener('pointerup', once); };
      addEventListener('touchend', once, { passive: true });
      addEventListener('pointerup', once, { passive: true });
    }
    // and if the phone comes back from the lock screen into portrait, the rotate card is CSS-driven, so it
    // reappears on its own; nothing to do here but keep the canvas the size of what we were given
    addEventListener('resize', () => { const c = document.getElementById('c'); if (c) { c.style.width = '100%'; c.style.height = '100%'; } });
  })();
</script>
<script>
  // INSTALLABLE: a service worker keeps the game shell for a fast, offline-tolerant relaunch (sw.js: network first, so a deploy always wins).
  // Only on https (or ?sw=1 on localhost); never inside a tool run (?nosw), where a cache between the test and the code would only confuse.
  (function () { try { const p = new URLSearchParams(location.search); if (!('serviceWorker' in navigator) || p.has('nosw')) return;
    if (location.protocol !== 'https:' && p.get('sw') !== '1') return;
    addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(() => {})); } catch (e) {} })();
</script>
